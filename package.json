{
  "name": "beat-buzzer",
  "productName": "Beat Buzzer",
  "version": "1.0.0",
  "description": "Beat Buzzer - by Ash Developers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "author": "Ash Developers",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ashdevelopers.beat-buzzer",
    "productName": "Beat Buzzer",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "!build/**"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}

